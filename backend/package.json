{
	"name": "backend",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "cf build",
		"deploy": "cf deploy",
		"typecheck": "cf workers types && tsc",
		"db:migrate": "cf d1 migrations apply b768b5e7-71b4-4ef5-88a5-1ce2d69085c3",
		"db:migrate:pending": "cf d1 migrations list b768b5e7-71b4-4ef5-88a5-1ce2d69085c3",
		"db:migrate:local":"cf d1 migrations apply b768b5e7-71b4-4ef5-88a5-1ce2d69085c3 --local --persist-to .cloudflare/state"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "beta",
		"cf": "^1.0.0-beta.5",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	}
}
